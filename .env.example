# -------------------------------------------------------
# .env.example — copy to .env and fill in your values
# -------------------------------------------------------

# Flask
SECRET_KEY=supersecret-flask-key-change-this
FLASK_DEBUG=true
PORT=5000

# JWT
JWT_SECRET_KEY=supersecret-jwt-key-change-this
JWT_EXPIRY_HOURS=24

# Database (SQLite by default; uncomment Postgres line below for PostgreSQL)
# DATABASE_URL=sqlite:///medical.db
# DATABASE_URL=postgresql://your_user:your_password@localhost:5432/medical_db

# Default admin seed credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@1234

# Login brute-force protection
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ── Image Encryption ──────────────────────────────────────────────────────
# AES-256 key: must be exactly 64 hex characters (32 bytes = 256 bits).
# Generate a fresh key with:
#   python -c "import os; print(os.urandom(32).hex())"
# NEVER commit a real key to version control.
AES_KEY=replace_this_with_64_hex_chars_generated_by_python

# Maximum image upload size (bytes) — default 50 MB enforced in app.py
# MAX_IMAGE_SIZE_BYTES=52428800

# ── HuggingFace API ───────────────────────────────────────────────────────
# Get a free token at: https://huggingface.co/settings/tokens
HF_API_KEY=hf_your_token_here

# Chest X-ray classification model (image-classification task)
HF_MODEL_ID=nickmuchi/vit-base-patch16-224-finetuned-chest-xray-pneumonia

# Timeout in seconds for HuggingFace Inference API requests
HF_TIMEOUT_S=40

# ── Groq API (Llama 3.3 70B — free tier) ─────────────────────────────────
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
